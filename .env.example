# Copiar a .env y completar con las claves reales.
# .env está ignorado por git: nunca lo subas al repositorio.
# docker-compose.yml le pasa estas variables al servicio de la base
# (MYSQL_*) y también al servicio web (MYSQL_HOST, MYSQL_DATABASE,
# MYSQL_USER, MYSQL_PASSWORD), que es de donde config/db.php las lee.

MYSQL_ROOT_PASSWORD=pon_aqui_tu_clave_root
MYSQL_DATABASE=sigra_etsr
MYSQL_USER=sigra_user
MYSQL_PASSWORD=pon_aqui_tu_clave_usuario
